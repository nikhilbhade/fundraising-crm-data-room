# Non-secret deployment settings. Copy these into your shell or CI environment.
GCP_PROJECT=your-project-id
GCP_REGION=asia-south1
CLOUD_RUN_SERVICE=fundraising-crm
CLOUD_SQL_INSTANCE=fundraising-crm-db
CLOUD_SQL_DATABASE=fundraising_crm
CLOUD_SQL_USER=fundraising_app
CLOUD_RUN_SERVICE_ACCOUNT=fundraising-crm-runtime@your-project-id.iam.gserviceaccount.com
ARTIFACT_REPOSITORY=fundraising-crm
DB_PASSWORD_SECRET=fundraising-crm-db-password
# Use iap for organization projects. For a personal/no-organization project,
# use shared_password and create the separate access-password secret in README.
CLOUD_RUN_AUTH_MODE=iap
CRM_ACCESS_PASSWORD_SECRET=fundraising-crm-access-password
CRM_DEFAULT_ACTOR=you@example.com
